# For local `npm run dev` (outside Docker), Next.js reads env vars from THIS
# directory, not the repo-root .env. Copy this to frontend/.env.local:
#
#   cp .env.example .env.local
#
# (Docker Compose instead injects the repo-root .env directly into the
# frontend container, so this file matters only for local `npm run dev`.)

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

NEXT_PUBLIC_CAMERA_FPS=12
NEXT_PUBLIC_CAMERA_WIDTH=640
NEXT_PUBLIC_CAMERA_HEIGHT=480
