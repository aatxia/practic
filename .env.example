# ============================================================
# UKSL Translator — Environment Configuration
# Copy to .env and adjust. Never commit the real .env file.
# ============================================================

# --- App ---
APP_ENV=development                 # development | production
LOG_LEVEL=INFO

# --- Backend / FastAPI ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- WebSocket ---
WS_MAX_MESSAGE_SIZE_BYTES=2097152   # 2 MB max per frame message
WS_MAX_FPS=15                       # server-side rate limit safeguard
WS_HEARTBEAT_INTERVAL_SEC=30

# --- Gloss-sequence aggregation (Phase 11) ---
WS_GLOSS_STABILITY_FRAMES=5         # consecutive identical predictions needed to confirm a sign
WS_GLOSS_CONFIDENCE_THRESHOLD=0.5   # predictions below this never count toward stability

# --- Facial grammar markers (Phase 17) -- not empirically calibrated, see
# ml/features/facial_grammar.py's module docstring before tuning these ---
WS_FACIAL_CALIBRATION_FRAMES=30     # frames of a detected face used to learn the signer's neutral baseline
WS_FACIAL_RAISED_RATIO=0.25         # eyebrow-eye gap must grow by this fraction of baseline to count as "raised"
WS_FACIAL_FURROWED_RATIO=0.25       # ...and shrink by this fraction to count as "furrowed"

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# --- Camera defaults (frontend) ---
CAMERA_FPS=12
CAMERA_WIDTH=640
CAMERA_HEIGHT=480

# Same values, exposed to the Next.js client bundle (must be NEXT_PUBLIC_ to be readable in the browser)
NEXT_PUBLIC_CAMERA_FPS=12
NEXT_PUBLIC_CAMERA_WIDTH=640
NEXT_PUBLIC_CAMERA_HEIGHT=480

# --- ML model ---
MODEL_TYPE=lstm                     # lstm | transformer | video_jepa
MODEL_CHECKPOINT_PATH=models/checkpoints/real_v1/latest.pt  # relative to repo root, not cwd
# real_v1 is trained on 99 real recorded clips of 7 words (WE/WANT/HAVE/WATER/
# NOT/PAST/I) -- see PROJECT_STATUS.md for accuracy and its single-signer
# caveat. If this checkpoint isn't present, camera-based word recognition is
# honestly unavailable rather than faked (see MLNotReadyError) -- retrain it
# with `python -m ml.training.train --annotations data/real/annotations/
# aatxia_annotations.jsonl --dataset-root . --experiment-name real_v1`.
MODEL_SEQUENCE_LENGTH=32
MODEL_DEVICE=cpu                    # cpu | cuda

# Feature toggles (must match configs/model.yaml)
FEATURES_HANDS=true
FEATURES_POSE=true
FEATURES_FACE=true

# --- NLP (Gloss -> Ukrainian text) ---
NLP_BACKEND=rule_based               # rule_based | huggingface
NLP_HF_MODEL_NAME=                   # e.g. a HF model repo id, if NLP_BACKEND=huggingface

# --- AI sentence-composition fallback (optional; app/services/
# ai_sentence_composer.py) -- ONLY consulted when the rule-based composer
# above can't match a pattern for the recognized words. Leave
# GEMINI_API_KEY empty to disable this entirely (default) -- no network
# call is ever attempted without a key. Get a free key at
# https://aistudio.google.com/ -- NEVER commit the real value here.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Text-to-Speech ---
TTS_PROVIDER=browser                 # browser | other (future)

# --- Speech-to-Text ---
STT_PROVIDER=browser                 # browser | whisper (future)

# --- Privacy / Security ---
STORE_RAW_VIDEO=false                # never store raw frames unless explicitly enabled
SEND_VIDEO_TO_THIRD_PARTY=false
